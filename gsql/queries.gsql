# TigerGraph 4.2 Community Edition. Prerequisite: import package gds, install function gds.**.
# A bounded exhaustive vector scan. Suitable for a small canary, not production-scale ANN.
# Only the authenticated owner's public vectors may be returned. Never expose this endpoint directly.
USE GRAPH $TG_GRAPH

CREATE OR REPLACE QUERY SimilarChunks(LIST<DOUBLE> q, INT topk, STRING embedding_type, STRING owner_id) FOR GRAPH $TG_GRAPH SYNTAX v3 {
  Ranked = SELECT d FROM (d:Document)
    WHERE d.owner_id == owner_id AND embedding_type == "public"
      AND gds.vector.dimension_count(d.embedding) == gds.vector.dimension_count(q)
      AND gds.vector.dimension_count(q) > 0
    ORDER BY gds.vector.distance(d.embedding, q, "COSINE") ASC LIMIT topk;
  PRINT Ranked;
}
INSTALL QUERY SimilarChunks
